# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Site URL
#
# There is no custom domain yet: the site runs on its Vercel URL, and
# alquifiestasyeventos.com still points at Odoo until that subscription lapses.
#
# NOTHING may hardcode the final domain. Canonical URLs, metadata, sitemap and
# any absolute link read from here, so the cutover is a config change rather
# than a find-and-replace.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — public. Safe to ship to the browser; RLS is what protects the data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://gxjrbxtafkshgsimhzek.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_k33zhJN6rHw2r7mJ9DyCqA_jNOQyZ3P

# ---------------------------------------------------------------------------
# Supabase — secret. IMPORT SCRIPTS ONLY.
#
# This key bypasses row-level security entirely. It must never be imported by
# anything under src/app or src/components, and never be prefixed NEXT_PUBLIC_.
# Get it from: Supabase dashboard > Project Settings > API > service_role
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection, for the migration dump, the SQL import runner and the
# availability test suite.
#
# USE THE POOLER, NOT THE DIRECT CONNECTION.
# The direct host (db.<ref>.supabase.co) has no A record — it is IPv6-only, and
# Node fails with ENOTFOUND on any network without IPv6. The pooler is IPv4.
#
#   Supabase dashboard > Project Settings > Database > Connection string
#     -> choose "Session pooler" (port 5432), not "Direct connection"
#
# It looks like this — note the username carries the project ref:
#   postgresql://postgres.gxjrbxtafkshgsimhzek:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# If auth fails, reset the password first:
#   Project Settings > Database > Reset database password
SUPABASE_DB_URL=
